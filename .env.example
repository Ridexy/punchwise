# Public site URL, used for canonical links, sitemap, share links and PDF footer. No trailing slash.
VITE_SITE_URL=https://hourtally.pages.dev
# Cloudflare Web Analytics beacon token (Cloudflare dashboard > Analytics & Logs > Web Analytics).
# It is public by design (it ships in the page). Leave empty to disable analytics.
VITE_CF_BEACON_TOKEN=
