    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "fake-indexeddb": "6.0.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
