# Public build-time settings (safe to commit: both values end up in the public page anyway).
# Change VITE_SITE_URL when you have a custom domain.
VITE_SITE_URL=https://punchwise.com
# Paste the Cloudflare Web Analytics token here (Analytics & Logs > Web Analytics > Add a site > manual snippet).
VITE_CF_BEACON_TOKEN=
# Growth events go to /api/e by default. Set to "off" to disable.
VITE_EVENTS_URL=
